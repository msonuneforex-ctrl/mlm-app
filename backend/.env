PORT=5000
NODE_ENV=production
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
ADMIN_EMAIL= 
ADMIN_PASSWORD= 
ROOT_EMAIL= 
ROOT_PASSWORD= 
# Your deployed frontend URL(s), comma-separated. Required in production —
# without it CORS defaults to allow-all. e.g. https://your-app.up.railway.app
FRONTEND_ORIGIN=
# Path to the SQLite file. Point this at a mounted Railway Volume (e.g.
# /data/mlm.db) so your data survives redeploys — Railway's own filesystem
# is wiped every time you deploy.
DB_PATH=
